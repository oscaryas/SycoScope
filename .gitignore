# Local handoff/session notes are not project documentation. Do not ignore
# Markdown globally: architecture plans, runbooks, and package READMEs should
# remain visible to Git review.
SESSION_SUMMARY.md

# prompt_probes: activation arrays and rendered report assets stay local.
# Generated JSONL, probe checkpoints, and compact provenance/metrics artifacts
# (run_info.json, meta.json, summary.json, analysis/*.json) stay tracked.
prompt_probes/results/**/*.npz
prompt_probes/results/**/*.npy
prompt_probes/results/**/*.csv
prompt_probes/results/**/*.png
prompt_probes/results/**/*.html
prompt_probes/results/**/*.css
prompt_probes/results/**/*.js
prompt_probes/results/**/*.lock
prompt_probes/data/perez_raw/
prompt_probes/data/perez_user_prompts.jsonl
.ipynb_checkpoints/

# SAE activation arrays and tabular analysis exports stay local. Trained
# checkpoints and generated JSONL are intentionally versioned.
SAE/results/**/*.npy
SAE/results/**/*.npz
SAE/results/**/*.parquet
SAE/results/**/*.lock
SAE/results/**/*.metadata
SAE/results/**/.cache/

