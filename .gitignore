__pycache__/
*.pyc
.venv/
.env
.DS_Store
SAE/results/activations/
SAE/notebooks/
SAE/results/runs/
tool_calling/tasks/sycophancy/runs/

# Large generated data/weights stay local-only going forward -- doesn't
# affect files already tracked (e.g. some older results/*.jsonl), only
# blocks new ones like this session's SyPR/social/mixture outputs from
# being accidentally committed.
tool_calling/tasks/sycophancy/results/**/*.pt
tool_calling/tasks/sycophancy/results/**/*.pth
tool_calling/tasks/sycophancy/results/**/*.jsonl

# Keep the tracked-markdown surface to README/CLAUDE/AGENTS only. Existing
# tracked files (e.g. tool_calling/tasks/*/skills/*.md) are unaffected --
# gitignore only blocks new/untracked paths from being added.
*.md
!/README.md
!/CLAUDE.md
!/AGENTS.md

# prompt_probes: generated data and probe weights stay local. The small
# provenance/metrics artifacts (run_info.json, meta.json, summary.json,
# analysis/*.json) stay tracked, matching the pattern in 075c614.
prompt_probes/results/**/*.jsonl
prompt_probes/results/**/*.npz
prompt_probes/results/**/*.npy
prompt_probes/results/**/*.pt
prompt_probes/results/**/*.pth
prompt_probes/results/**/*.csv
prompt_probes/results/**/*.png
prompt_probes/data/perez_raw/
prompt_probes/data/perez_user_prompts.jsonl
